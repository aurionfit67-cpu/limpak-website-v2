# LIMEPAK Environment Variables
# Copy this file to .env.local for development

# Next.js Configuration
NEXT_PUBLIC_APP_URL=https://limepak.vercel.app
NEXT_PUBLIC_API_URL=https://api.limepak.vercel.app

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=

# Android APK Configuration
NEXT_PUBLIC_APK_VERSION=1.0.0
NEXT_PUBLIC_APK_DOWNLOAD_URL=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false

# Capacitor Configuration
CAPACITOR_ANDROID_STUDIO_PATH=

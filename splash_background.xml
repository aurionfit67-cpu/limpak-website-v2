<?xml version="1.0" encoding="utf-8"?>
<!-- LIMEPAK Splash Screen Background -->

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/limepakBackground" />
        </shape>
    </item>
    
    <!-- LIMEPAK Logo Center -->
    <item android:gravity="center">
        <shape android:shape="rectangle" android:width="200dp" android:height="200dp">
            <solid android:color="@color/limepakPrimary" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
